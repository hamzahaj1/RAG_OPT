# ─── PostgreSQL (conteneur) ───────────────────────────────────────────
# Identifiants du serveur PostgreSQL lancé par docker-compose.yml.
POSTGRES_DB=alpha_scope_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ─── Accès applicatif (SQLAlchemy async) ──────────────────────────────
# DSN consommé par app/core/config.py — doit rester cohérent avec les
# trois variables POSTGRES_* ci-dessus.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/alpha_scope_dev

# Echo SQL de SQLAlchemy (true uniquement pour déboguer les requêtes).
SQLALCHEMY_ECHO=false

# ─── FastAPI ──────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
